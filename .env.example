# Runtime settings for Hermes. Replace every __REQUIRED__ value locally.
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1
PORT=80
DATABASE_URL=postgresql://__REQUIRED__:__REQUIRED__@postgres-db:5432/hermes_production
HERMES_ADMIN_EMAIL=admin@example.invalid
HERMES_ADMIN_PASSWORD=__REQUIRED__
HERMES_ENCRYPTION_PRIMARY_KEY=__REQUIRED__
HERMES_ENCRYPTION_DETERMINISTIC_KEY=__REQUIRED__
HERMES_ENCRYPTION_KEY_DERIVATION_SALT=__REQUIRED__
