# Private runtime settings for the Hermes production service.
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
DB_POOL=8
JOB_CONCURRENCY=1
PORT=80
RAILS_MASTER_KEY=__REQUIRED__
SECRET_KEY_BASE=__REQUIRED__
HERMES_ADMIN_EMAIL=__REQUIRED__
HERMES_ADMIN_PASSWORD=__REQUIRED__
HERMES_ENCRYPTION_PRIMARY_KEY=__REQUIRED__
HERMES_ENCRYPTION_DETERMINISTIC_KEY=__REQUIRED__
HERMES_ENCRYPTION_KEY_DERIVATION_SALT=__REQUIRED__
