<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hermes — <%= content_for(:title) { "Dashboard" } %></title>
    <meta name="description" content="Hermes Email Gateway Dashboard">
    <%= favicon_link_tag 'logo.ico', type: 'image/x-icon' %>
    <%= favicon_link_tag 'logo.png', rel: 'apple-touch-icon', type: 'image/png' %>
    <%= render "layouts/design_system" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="ffds-root hermes-root">
    <div class="ffds-app-container hermes-app">
      <header class="hermes-topbar">
        <%= link_to dashboard_root_path, class: "ffds-navbar-brand hermes-brand" do %>
          <%= image_tag "logo.png", alt: "", class: "brand-icon" %><span>Hermes</span>
        <% end %>
        <span class="hermes-topbar-caption">Email Gateway</span>
      </header>
      <div class="ffds-app-main hermes-app-main">
        <aside class="ffds-sidebar hermes-sidebar">
          <div class="sidebar__brand">
            <span class="eyebrow">WORKSPACE</span>
            <strong>Mail operations</strong>
          </div>
          <nav class="ffds-sidebar-nav hermes-sidebar-nav" aria-label="Main navigation">
            <%= link_to dashboard_root_path, class: "ffds-sidebar-link #{"ffds-active" if current_page?(dashboard_root_path)}" do %>
              <i data-lucide="layout-dashboard"></i><span>Overview</span>
            <% end %>
            <%= link_to dashboard_messages_path, class: "ffds-sidebar-link #{"ffds-active" if request.path.start_with?("/dashboard/messages")}" do %>
              <i data-lucide="mail"></i><span>Messages</span>
            <% end %>
            <%= link_to dashboard_clients_path, class: "ffds-sidebar-link #{"ffds-active" if request.path.start_with?("/dashboard/clients")}" do %>
              <i data-lucide="key-round"></i><span>API Clients</span>
            <% end %>
            <%= link_to dashboard_smtp_providers_path, class: "ffds-sidebar-link #{"ffds-active" if request.path.start_with?("/dashboard/providers")}" do %>
              <i data-lucide="server"></i><span>SMTP Providers</span>
            <% end %>
            <%= link_to edit_dashboard_settings_path, class: "ffds-sidebar-link #{"ffds-active" if request.path.start_with?("/dashboard/settings")}" do %>
              <i data-lucide="settings-2"></i><span>Settings</span>
            <% end %>
          </nav>
          <div class="sidebar__footer">
            <%= link_to logout_path, method: :delete, class: "ffds-sidebar-link hermes-signout",
                  data: { turbo_method: :delete } do %>
              <i data-lucide="log-out"></i><span>Sign Out</span>
            <% end %>
          </div>
        </aside>
        <main class="ffds-content-area hermes-content">
          <div class="hermes-page">
            <% if flash[:notice] %>
              <div class="ffds-alert ffds-alert-success"><%= flash[:notice] %></div>
            <% end %>
            <% if flash[:alert] %>
              <div class="ffds-alert ffds-alert-danger"><%= flash[:alert] %></div>
            <% end %>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
