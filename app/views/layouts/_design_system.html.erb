<% design_system_url = ENV.fetch("HERMES_DESIGN_SYSTEM_URL", "/design-system").delete_suffix("/") %>
<link rel="stylesheet" href="<%= design_system_url %>/farmacia-ds.min.css" data-turbo-track="reload">
<script src="<%= design_system_url %>/farmacia-ds.min.js" defer data-turbo-track="reload"></script>
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("<%= design_system_url %>/fonts/dm-sans-latin.woff2") format("woff2");
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
  }
  @font-face {
    font-family: "DM Mono";
    src: url("<%= design_system_url %>/fonts/dm-mono-400-latin.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Playfair Display";
    src: url("<%= design_system_url %>/fonts/playfair-display-latin.woff2") format("woff2");
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }
</style>
<script>
  document.addEventListener("turbo:load", () => window.FFDS && window.FFDS.createIcons());
</script>
