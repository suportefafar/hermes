<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @subject %></title>
</head>
<body style="margin: 0; padding: 0;">
<!-- Wrapper -->
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f9f8f6; font-family: Arial, sans-serif;">
  <tr>
    <td align="center" style="padding: 32px 16px;">

      <!-- Container -->
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; background-color: #ffffff; border-radius: 4px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">

        <!-- Header -->
        <tr>
          <td style="background-color: #1a1a1a; padding: 24px; border-top: 4px solid #f2b600; text-align: center;">
            <h1 style="margin: 0; color: #f2b600; font-family: Georgia, serif; font-size: 24px;">Farmácia UFMG</h1>
          </td>
        </tr>

        <!-- Content -->
        <tr>
          <td style="padding: 32px; color: #2d2520; font-size: 16px; line-height: 1.5;">
            <%= raw @body_html %>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background-color: #f2f0ec; padding: 24px; text-align: center; color: #706860; font-size: 12px;">
            <p style="margin: 0;">&copy; <%= Date.current.year %> Faculdade de Farmácia &mdash; UFMG<br>Avenida Antônio Carlos, 6627 - Pampulha, Belo Horizonte - MG</p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
