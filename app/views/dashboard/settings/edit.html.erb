<div class="page-header">
  <h1 class="ffds-h3">Settings</h1>
</div>

<div class="ffds-card hermes-card hermes-form-card">
  <div class="ffds-card-body">
    <%= form_with url: dashboard_settings_path, method: :patch, class: "form" do |f| %>
      <% if flash[:notice] %>
        <div class="ffds-alert ffds-alert-success"><%= flash[:notice] %></div>
      <% end %>

      <div class="ffds-form-group field">
        <label class="ffds-form-label">Rate Limit (emails per minute)</label>
        <input type="number" name="settings[rate_limit_per_minute]"
               value="<%= @settings.find { |s| s.key == "rate_limit_per_minute" }&.value %>"
               class="ffds-form-control" min="1" max="10000" />
        <span class="field-hint">Global cap. Excess emails wait in the queue for the next minute window.</span>
      </div>

      <div class="ffds-form-group field">
        <label class="ffds-form-label">Fallback Threshold (%)</label>
        <input type="number" name="settings[fallback_threshold_pct]"
               value="<%= @settings.find { |s| s.key == "fallback_threshold_pct" }&.value %>"
               class="ffds-form-control" min="1" max="100" />
        <span class="field-hint">If the primary provider fails this % of the last batch, switch to the fallback provider.</span>
      </div>

      <div class="ffds-form-group field">
        <label class="ffds-form-label">Max Retry Attempts</label>
        <input type="number" name="settings[max_retry_attempts]"
               value="<%= @settings.find { |s| s.key == "max_retry_attempts" }&.value %>"
               class="ffds-form-control" min="1" max="10" />
        <span class="field-hint">Number of soft-bounce retries before marking as permanently failed.</span>
      </div>

      <div class="form-actions">
        <input type="submit" value="Save Settings" class="ffds-btn ffds-btn-primary" />
      </div>
    <% end %>
  </div>
</div>
