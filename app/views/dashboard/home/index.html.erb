<div class="page-header">
  <h1 class="ffds-h3">Overview</h1>
  <span class="page-subtitle">Email Gateway — <%= Time.current.strftime("%b %d, %Y") %></span>
</div>

<% if @provider_warning %>
  <div class="ffds-alert ffds-alert-warning alert-banner">
    ⚠️ <strong>Provider Warning:</strong> The primary SMTP provider is experiencing high failure rates and no fallback is configured. Emails are being queued.
  </div>
<% end %>

<!-- Stats grid -->
<div class="stats-grid">
  <div class="ffds-stat-card stat-card stat-card--pending">
    <div class="ffds-stat-value stat-value"><%= @total_pending %></div>
    <div class="ffds-stat-label stat-label">Pending</div>
    <div class="stat-sub">in queue</div>
  </div>
  <div class="ffds-stat-card stat-card stat-card--sent">
    <div class="ffds-stat-value stat-value"><%= @total_sent %></div>
    <div class="ffds-stat-label stat-label">Delivered</div>
    <div class="stat-sub"><%= @today_sent %> today</div>
  </div>
  <div class="ffds-stat-card stat-card stat-card--failed">
    <div class="ffds-stat-value stat-value"><%= @total_failed %></div>
    <div class="ffds-stat-label stat-label">Failed</div>
    <div class="stat-sub"><%= @today_failed %> today</div>
  </div>
  <div class="ffds-stat-card stat-card stat-card--malformed">
    <div class="ffds-stat-value stat-value"><%= @total_malformed %></div>
    <div class="ffds-stat-label stat-label">Malformed</div>
    <div class="stat-sub">rejected at ingestion</div>
  </div>
</div>

<!-- Chart -->
<div class="ffds-card hermes-card">
  <div class="ffds-card-header">
    <h2 class="ffds-h5">Emails — Last 14 Days</h2>
  </div>
  <div class="ffds-card-body">
    <%= column_chart @emails_by_day, stacked: true, colors: ["#f59e0b", "#10b981", "#ef4444", "#6b7280"],
        library: { scales: { y: { beginAtZero: true } } } %>
  </div>
</div>

<!-- Recent messages -->
<div class="ffds-card hermes-card">
  <div class="ffds-card-header">
    <h2 class="ffds-h5">Recent Messages</h2>
    <%= link_to "View all →", dashboard_messages_path, class: "ffds-link hermes-card-action" %>
  </div>
  <div class="ffds-card-body hermes-card-body--flush">
    <table class="table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Client</th>
          <th>To</th>
          <th>Subject</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_messages.each do |msg| %>
          <tr>
            <td class="ffds-text-muted"><%= msg.created_at.strftime("%m/%d %H:%M") %></td>
            <td><span class="ffds-badge ffds-badge-light"><%= msg.api_client&.name || "—" %></span></td>
            <td class="ffds-text-truncate"><%= Array(msg.to_addresses).first %></td>
            <td class="ffds-text-truncate"><%= msg.subject %></td>
            <td><span class="ffds-badge status-badge status-badge--<%= msg.status %>"><%= msg.status %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
