<div class="page-header">
  <h1 class="ffds-h3">SMTP Providers</h1>
  <%= link_to "New Provider", new_dashboard_smtp_provider_path, class: "ffds-btn ffds-btn-primary" %>
</div>

<div class="ffds-card hermes-card">
  <div class="ffds-card-body hermes-card-body--flush">
    <table class="table">
      <thead>
        <tr>
          <th>Priority</th>
          <th>Name</th>
          <th>Host</th>
          <th>From</th>
          <th>Failures</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @providers.each do |provider| %>
          <tr>
            <td class="ffds-text-center"><%= provider.priority %></td>
            <td><strong><%= provider.name %></strong></td>
            <td class="ffds-font-mono ffds-small"><%= provider.host %>:<%= provider.port %></td>
            <td class="ffds-text-muted ffds-small"><%= provider.from_address %></td>
            <td class="ffds-text-center <%= provider.failure_count > 0 ? "ffds-text-danger" : "" %>">
              <%= provider.failure_count %>
            </td>
            <td>
              <% if provider.active? %>
                <span class="ffds-badge status-badge status-badge--sent"><%= provider.priority == 1 ? "Primary" : "Fallback" %></span>
              <% else %>
                <span class="ffds-badge status-badge status-badge--failed">Inactive</span>
              <% end %>
            </td>
            <td class="ffds-text-right">
              <%= link_to "Edit", edit_dashboard_smtp_provider_path(provider), class: "ffds-btn ffds-btn-sm ffds-btn-ghost" %>
              <%= button_to provider.active? ? "Disable" : "Enable",
                    toggle_active_dashboard_smtp_provider_path(provider), method: :patch,
                    class: "ffds-btn ffds-btn-sm #{provider.active? ? "ffds-btn-danger" : "ffds-btn-secondary"}" %>
              <%= button_to "Delete", dashboard_smtp_provider_path(provider), method: :delete,
                    class: "ffds-btn ffds-btn-sm ffds-btn-danger",
                    data: { turbo_confirm: "Delete this provider? This cannot be undone." } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
