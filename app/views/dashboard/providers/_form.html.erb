<div class="page-header">
  <%= link_to "← Providers", dashboard_smtp_providers_path, class: "back-link" %>
  <h1 class="ffds-h3"><%= @provider.new_record? ? "New SMTP Provider" : "Edit #{@provider.name}" %></h1>
</div>

<div class="ffds-card hermes-card hermes-form-card">
  <div class="ffds-card-body">
    <%= form_with model: [:dashboard, @provider], class: "form" do |f| %>
      <% if @provider.errors.any? %>
        <div class="ffds-alert ffds-alert-danger form-errors">
          <% @provider.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
        </div>
      <% end %>

      <div class="field-row">
        <div class="ffds-form-group field">
          <%= f.label :name, "Provider Name", class: "ffds-form-label" %>
          <%= f.text_field :name, class: "ffds-form-control", placeholder: "e.g. SendGrid Primary" %>
        </div>
        <div class="ffds-form-group field field--sm">
          <%= f.label :priority, "Priority", class: "ffds-form-label" %>
          <%= f.number_field :priority, class: "ffds-form-control", min: 1, placeholder: "1" %>
          <span class="field-hint">1 = primary</span>
        </div>
      </div>

      <div class="field-row">
        <div class="ffds-form-group field">
          <%= f.label :host, "SMTP Host", class: "ffds-form-label" %>
          <%= f.text_field :host, class: "ffds-form-control", placeholder: "smtp.sendgrid.net" %>
        </div>
        <div class="ffds-form-group field field--sm">
          <%= f.label :port, "Port", class: "ffds-form-label" %>
          <%= f.number_field :port, class: "ffds-form-control", placeholder: "587" %>
        </div>
      </div>

      <div class="field-row">
        <div class="ffds-form-group field">
          <%= f.label :username, "Username", class: "ffds-form-label" %>
          <%= f.text_field :username, class: "ffds-form-control", autocomplete: "off" %>
        </div>
        <div class="ffds-form-group field">
          <%= f.label :password, "Password / API Key", class: "ffds-form-label" %>
          <%= f.password_field :password, class: "ffds-form-control", autocomplete: "new-password",
                placeholder: @provider.new_record? ? "" : "(leave blank to keep current)" %>
        </div>
      </div>

      <div class="ffds-form-group field">
        <%= f.label :from_address, "Default From Address", class: "ffds-form-label" %>
        <%= f.email_field :from_address, class: "ffds-form-control", placeholder: "noreply@farmacia.ufmg.br" %>
      </div>

      <div class="form-actions">
        <%= f.submit @provider.new_record? ? "Create Provider" : "Update Provider", class: "ffds-btn ffds-btn-primary" %>
        <%= link_to "Cancel", dashboard_smtp_providers_path, class: "ffds-btn ffds-btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
