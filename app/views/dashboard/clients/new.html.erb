<div class="page-header">
  <%= link_to "← Clients", dashboard_clients_path, class: "back-link" %>
  <h1 class="ffds-h3">New API Client</h1>
</div>

<div class="ffds-card hermes-card hermes-form-card">
  <div class="ffds-card-body">
    <%= form_with model: @client, url: dashboard_clients_path, class: "form" do |f| %>
      <% if @client.errors.any? %>
        <div class="ffds-alert ffds-alert-danger form-errors">
          <% @client.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="ffds-form-group field">
        <%= f.label :name, "Client Name", class: "ffds-form-label" %>
        <%= f.text_field :name, placeholder: "e.g. WordPress Site", class: "ffds-form-control", autofocus: true %>
        <span class="field-hint">A friendly name to identify this service in the email log.</span>
      </div>

      <div class="form-actions">
        <%= f.submit "Generate Token & Create", class: "ffds-btn ffds-btn-primary" %>
        <%= link_to "Cancel", dashboard_clients_path, class: "ffds-btn ffds-btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
