<div class="page-header">
  <h1 class="ffds-h3">Client Created</h1>
</div>

<div class="ffds-card hermes-card hermes-form-card">
  <div class="ffds-card-body">
    <div class="token-reveal">
      <div class="token-reveal__icon">🔑</div>
      <h2 class="ffds-h5">Copy your API token now</h2>
      <p class="token-reveal__warning">This token will <strong>never be shown again</strong>. Store it somewhere safe.</p>

      <div class="token-box" id="token-box">
        <code id="client-token"><%= @raw_token %></code>
        <button class="ffds-btn ffds-btn-sm ffds-btn-ghost" onclick="navigator.clipboard.writeText(document.getElementById('client-token').innerText).then(() => this.innerText = 'Copied!')">Copy</button>
      </div>

      <dl class="dl dl--inline">
        <dt>Client Name</dt><dd><%= @client.name %></dd>
        <dt>Status</dt><dd>Active</dd>
      </dl>

      <div class="form-actions">
        <%= link_to "Go to Clients", dashboard_clients_path, class: "ffds-btn ffds-btn-primary" %>
      </div>
    </div>
  </div>
</div>
