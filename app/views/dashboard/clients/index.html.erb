<div class="page-header">
  <h1 class="ffds-h3">API Clients</h1>
  <%= link_to "New Client", new_dashboard_client_path, class: "ffds-btn ffds-btn-primary" %>
</div>

<div class="ffds-card hermes-card">
  <div class="ffds-card-body hermes-card-body--flush">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Token (prefix)</th>
          <th>Status</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td><strong><%= client.name %></strong></td>
            <td class="ffds-font-mono ffds-text-muted"><%= client.token_digest[0..15] %>…</td>
            <td>
              <% if client.active? %>
                <span class="ffds-badge status-badge status-badge--sent">Active</span>
              <% else %>
                <span class="ffds-badge status-badge status-badge--failed">Revoked</span>
              <% end %>
            </td>
            <td class="ffds-text-muted"><%= client.created_at.strftime("%b %d, %Y") %></td>
            <td class="ffds-text-right">
              <div class="table-actions">
                <%= button_to client.active? ? "Revoke" : "Activate",
                      toggle_active_dashboard_client_path(client), method: :patch,
                      class: "ffds-btn ffds-btn-sm #{client.active? ? "ffds-btn-danger" : "ffds-btn-secondary"}",
                      data: { turbo_confirm: "Are you sure?" } %>
                <%= button_to "Delete", dashboard_client_path(client), method: :delete,
                      class: "ffds-btn ffds-btn-sm ffds-btn-danger",
                      data: { turbo_confirm: "Permanently delete #{client.name}? Its API token will stop working. Existing messages will stay in history." } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
